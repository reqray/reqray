{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"],

    // tsup injects `baseUrl` into its dts build, which TypeScript 6 deprecated.
    // Drop this together with the move to TypeScript 7 — that move also needs a
    // tsup version whose dts build works without `baseUrl`.
    "ignoreDeprecations": "6.0",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    // Packages resolve to sources so typecheck and tests need no prior build.
    // The same list is duplicated in vitest.config.ts — update both.
    "paths": {
      "@reqray/core": ["./packages/core/src/index.ts"],
      "@reqray/core/panel": ["./packages/core/src/panel/index.ts"],
      "@reqray/core/testing": ["./packages/core/src/testing.ts"],
      "@reqray/protocol": ["./packages/protocol/src/index.ts"],
      "@reqray/waterfall": ["./packages/waterfall/src/index.ts"],
      "@reqray/cli": ["./packages/cli/src/index.ts"],
      "@reqray/register": ["./packages/register/src/index.ts"],
      "@reqray/express": ["./packages/express/src/index.ts"],
      "@reqray/fastify": ["./packages/fastify/src/index.ts"],
      "@reqray/store-memory": ["./packages/store-memory/src/index.ts"],
      "@reqray/store-sqlite": ["./packages/store-sqlite/src/index.ts"],
      "@reqray/transport-file": ["./packages/transport-file/src/index.ts"],
      "@reqray/transport-http": ["./packages/transport-http/src/index.ts"],
      "@reqray/server": ["./packages/server/src/index.ts"],
      "@reqray/nestjs": ["./packages/nestjs/src/index.ts"],
      "@reqray/instrumentation-ioredis": ["./packages/instrumentation-ioredis/src/index.ts"],
      "@reqray/instrumentation-pg": ["./packages/instrumentation-pg/src/index.ts"],
      "@reqray/instrumentation-prisma": ["./packages/instrumentation-prisma/src/index.ts"],
      "@reqray/instrumentation-undici": ["./packages/instrumentation-undici/src/index.ts"]
    }
  }
}
