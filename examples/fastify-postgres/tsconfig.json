{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The UI test runs code inside the browser via `page.evaluate`, so it
    // legitimately needs DOM types alongside the Node ones.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["test"]
}
