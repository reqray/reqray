{
  "name": "@reqray/express",
  "version": "0.1.0",
  "description": "Express adapter for Reqray.",
  "license": "MIT",
  "keywords": [
    "nodejs",
    "debugging",
    "profiling",
    "n+1",
    "sql",
    "observability",
    "devtools",
    "fastify",
    "express",
    "nestjs"
  ],
  "homepage": "https://github.com/reqray/reqray#readme",
  "bugs": "https://github.com/reqray/reqray/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reqray/reqray.git",
    "directory": "packages/express"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reqray/core": "workspace:^",
    "@reqray/store-memory": "workspace:^",
    "@reqray/dashboard": "workspace:^"
  },
  "peerDependencies": {
    "express": "^4 || ^5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@types/express": "^5.0.6",
    "express": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  }
}
