{
  "name": "@reqray/nestjs",
  "version": "0.1.0",
  "description": "Reqray for NestJS: one module in imports, and every request is a waterfall with its SQL, cache and outgoing calls. Finds N+1 down to the line.",
  "license": "MIT",
  "keywords": [
    "nodejs",
    "debugging",
    "profiling",
    "n+1",
    "sql",
    "observability",
    "devtools",
    "fastify",
    "express",
    "nestjs"
  ],
  "homepage": "https://github.com/reqray/reqray#readme",
  "bugs": "https://github.com/reqray/reqray/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reqray/reqray.git",
    "directory": "packages/nestjs"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reqray/core": "workspace:^",
    "@reqray/express": "workspace:^",
    "@reqray/fastify": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": "^10 || ^11",
    "@nestjs/core": "^10 || ^11",
    "rxjs": "^7"
  },
  "devDependencies": {
    "@reqray/store-memory": "workspace:^",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-fastify": "^11.2.1",
    "@nestjs/testing": "^11.2.1",
    "@types/node": "catalog:",
    "fastify": "^5.7.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
