{
  "name": "@reqray/register",
  "version": "0.0.0",
  "description": "Loader hooks (CJS + ESM) for automatic Reqray instrumentation.",
  "license": "MIT",
  "keywords": [
    "nodejs",
    "debugging",
    "profiling",
    "n+1",
    "sql",
    "observability",
    "devtools",
    "fastify",
    "express",
    "nestjs"
  ],
  "homepage": "https://github.com/reqray/reqray#readme",
  "bugs": "https://github.com/reqray/reqray/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reqray/reqray.git",
    "directory": "packages/register"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reqray/core": "workspace:^",
    "@reqray/instrumentation-pg": "workspace:^",
    "@reqray/instrumentation-ioredis": "workspace:^",
    "@reqray/store-memory": "workspace:^",
    "@reqray/dashboard": "workspace:^",
    "@reqray/instrumentation-undici": "workspace:^",
    "import-in-the-middle": "^3.3.3",
    "require-in-the-middle": "^8.0.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "@types/semver": "^7.8.0",
    "pg": "^8.23.0"
  }
}
