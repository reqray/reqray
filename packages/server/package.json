{
  "name": "@reqray/server",
  "version": "0.1.0",
  "description": "Reqray collector: batch ingestion from applications, storage, and the dashboard.",
  "license": "MIT",
  "keywords": [
    "nodejs",
    "debugging",
    "profiling",
    "n+1",
    "sql",
    "observability",
    "devtools",
    "fastify",
    "express",
    "nestjs"
  ],
  "homepage": "https://github.com/reqray/reqray#readme",
  "bugs": "https://github.com/reqray/reqray/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reqray/reqray.git",
    "directory": "packages/server"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "reqray-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@reqray/core": "workspace:^",
    "@reqray/dashboard": "workspace:^",
    "@reqray/transport-file": "workspace:^",
    "@reqray/store-memory": "workspace:^",
    "@reqray/store-sqlite": "workspace:^"
  },
  "devDependencies": {
    "@reqray/transport-http": "workspace:^",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
